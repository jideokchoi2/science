rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 "게시"를 누르세요.
// 로그인(인증) 기능 없이 반 코드만으로 구분하는 구조라, 접근 자체를 막기보다
// "이상한 값이 저장되지 않도록" 데이터 모양을 검사하는 데 목적이 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {

      // 반 순위표: 닉네임 10자 이내, 점수는 0~800(8행성 x 100점) 사이만 허용
      match /leaderboard/{playerId} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasOnly(['nickname', 'totalScore', 'submittedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 10
          && request.resource.data.totalScore is number
          && request.resource.data.totalScore >= 0
          && request.resource.data.totalScore <= 800;
      }

      // 대기열
      match /queue/{playerId} {
        allow read, write: if true;
      }

      // 대결 기록
      match /matches/{matchId} {
        allow read, write: if true;
      }

      // 명예의 전당(승수)
      match /wins/{playerId} {
        allow read, write: if true;
      }
    }
  }
}
